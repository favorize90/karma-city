# =================================================================
# Karma City — Local Environment Configuration
# =================================================================
# Copy this file to `.env.local` and fill in your Supabase credentials.
# `.env.local` is gitignored and will never be committed.
#
# Where to get the values:
#   1. Go to https://supabase.com/dashboard
#   2. Open your project (or create one - choose EU region for DSGVO)
#   3. Settings → API → Project URL  → NEXT_PUBLIC_SUPABASE_URL
#   4. Settings → API → anon public  → NEXT_PUBLIC_SUPABASE_ANON_KEY
# =================================================================

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-public-key...

# Optional: site URL for email-redirect templates (only needed in prod)
# NEXT_PUBLIC_SITE_URL=https://karma-city.example.com
